# 로그인 쿠키 서명용 비밀값 (아무 긴 랜덤 문자열). 만들기: openssl rand -base64 32
SESSION_SECRET=

# Firebase 서비스 계정 (Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성)
# 비워 두면 로컬 개발에서는 .data/db.json 파일에 저장돼요. 배포(Vercel)에서는 꼭 필요해요.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON 파일의 private_key 값을 그대로 붙여넣기 (\n 포함, 큰따옴표로 감싸기)
FIREBASE_PRIVATE_KEY=
